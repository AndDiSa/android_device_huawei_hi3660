cc_library_shared {
    name: "liblogshim",
    proprietary: true,
    defaults: ["hidl_defaults"],
    srcs: [
        "hwlog.cpp",
    ],
    shared_libs: [
        "liblog",
    ],
}

cc_library_shared {
    name: "libshim_audioparams",
    srcs: ["libshim_audioparams.cpp"],
    shared_libs: [
        "libbase",
        "libcutils",
    ],
    vendor: true,
}
