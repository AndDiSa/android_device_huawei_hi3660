    name: "fstab.hi3660",
    src: "fstab.hi3660",
    ramdisk_available: true,
    vendor: true,
}

prebuilt_etc {
    name: "fstab.modem",
    src: "fstab.modem",
    vendor: true,
}

prebuilt_etc {
    name: "init.hi3660.rc",
    src: "etc/init.hi3660.rc",
    sub_dir: "init/hw",
    vendor: true,
}
