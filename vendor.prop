# Audio
persist.kirin.media.hires.enable=true
persist.kirin.media.lowlatency.enable=false
persist.kirin.media.offload.enable=true
persist.kirin.media.usbvoice.enable=true

# Camera
vendor.camera.dis.flag=2
vendor.camera.tnr.flag=1

# Display
ro.opengles.version=196610

# Fastbootd
ro.fastbootd.available=true

# Gralloc
vendor.debug.config.mmu_en=1
persist.vendor.smart_pool=1

# SurfaceFlinger
debug.sf.latch_unsignaled=1
debug.sf.disable_backpressure=1
ro.surface_flinger.running_without_sync_framework=true

# vowifi
ro.vendor.config.hw_vowifi=true
